const SUPABASE_URL = process.env.SUPABASE_URL;
const SUPABASE_SERVICE_ROLE_KEY =
  process.env.SUPABASE_SERVICE_ROLE_KEY;

function json(res, status, data) {
  return res.status(status).json(data);
}

async function supabase(path, options = {}) {
  if (!SUPABASE_URL) {
    throw new Error("SUPABASE_URL is not configured.");
  }

  if (!SUPABASE_SERVICE_ROLE_KEY) {
    throw new Error(
      "SUPABASE_SERVICE_ROLE_KEY is not configured."
    );
  }

  const response = await fetch(
    `${SUPABASE_URL}/rest/v1/${path}`,
    {
      ...options,
      headers: {
        apikey: SUPABASE_SERVICE_ROLE_KEY,
        Authorization:
          `Bearer ${SUPABASE_SERVICE_ROLE_KEY}`,
        "Content-Type": "application/json",
        Accept: "application/json",
        Prefer: "return=representation",
        ...(options.headers || {})
      }
    }
  );

  const text = await response.text();

  let data = {};

  try {
    data = text ? JSON.parse(text) : {};
  } catch {
    throw new Error(
      `Supabase returned invalid JSON (HTTP ${response.status}).`
    );
  }

  if (!response.ok) {
    throw new Error(
      data?.message ||
      data?.hint ||
      data?.details ||
      `Supabase request failed (HTTP ${response.status}).`
    );
  }

  return data;
}

async function getAuthenticatedUser(req) {
  const auth =
    req.headers.authorization ||
    req.headers.Authorization ||
    "";

  if (!auth.startsWith("Bearer ")) {
    throw new Error("Unauthorized.");
  }

  const token = auth.slice(7).trim();

  const response = await fetch(
    `${SUPABASE_URL}/auth/v1/user`,
    {
      headers: {
        apikey:
          process.env.SUPABASE_ANON_KEY ||
          process.env.SUPABASE_PUBLISHABLE_KEY ||
          "",
        Authorization: `Bearer ${token}`,
        Accept: "application/json"
      }
    }
  );

  if (!response.ok) {
    throw new Error("Unauthorized.");
  }

  const user = await response.json();

  if (!user?.id) {
    throw new Error("Unauthorized.");
  }

  return user;
}

async function isAdmin(userId) {
  const rows = await supabase(
    `profiles?id=eq.${encodeURIComponent(userId)}` +
    `&select=id,role&limit=1`
  );

  return rows?.[0]?.role === "admin";
}

export default async function handler(req, res) {
  try {
    /*
      GET /api/deposit?admin=true
      Admin deposit requests
    */
    if (
      req.method === "GET" &&
      String(req.query?.admin || "") === "true"
    ) {
      const user = await getAuthenticatedUser(req);

      if (!(await isAdmin(user.id))) {
        return json(res, 403, {
          success: false,
          error: "Admin access required."
        });
      }

      const deposits = await supabase(
        "deposits?select=*&order=created_at.desc"
      );

      return json(res, 200, {
        success: true,
        deposits
      });
    }

    /*
      POST /api/deposit
      Customer creates a pending deposit.
    */
    if (req.method === "POST") {
      const user = await getAuthenticatedUser(req);

      const body =
        typeof req.body === "string"
          ? JSON.parse(req.body || "{}")
          : (req.body || {});

      /*
        Admin approve/reject
      */
      if (body.admin === true) {
        if (!(await isAdmin(user.id))) {
          return json(res, 403, {
            success: false,
            error: "Admin access required."
          });
        }

        const depositId = body.depositId;
        const action = String(body.action || "")
          .toLowerCase();

        if (!depositId) {
          return json(res, 400, {
            success: false,
            error: "depositId is required."
          });
        }

        if (!["approve", "reject"].includes(action)) {
          return json(res, 400, {
            success: false,
            error:
              "Action must be approve or reject."
          });
        }

        const rows = await supabase(
          `deposits?id=eq.${encodeURIComponent(depositId)}` +
          `&select=*`
        );

        const deposit = rows?.[0];

        if (!deposit) {
          return json(res, 404, {
            success: false,
            error: "Deposit request not found."
          });
        }

        if (deposit.status !== "pending") {
          return json(res, 400, {
            success: false,
            error:
              `This deposit is already ${deposit.status}.`
          });
        }

        if (action === "reject") {
          const updated = await supabase(
            `deposits?id=eq.${encodeURIComponent(depositId)}`,
            {
              method: "PATCH",
              body: JSON.stringify({
                status: "rejected",
                approved_by: user.id,
                approved_at:
                  new Date().toISOString(),
                updated_at:
                  new Date().toISOString()
              })
            }
          );

          return json(res, 200, {
            success: true,
            message: "Deposit rejected.",
            deposit: updated?.[0] || null
          });
        }

        const amount =
          Number(deposit.amount);

        if (!Number.isFinite(amount) || amount <= 0) {
          return json(res, 400, {
            success: false,
            error: "Invalid deposit amount."
          });
        }

        const walletRows = await supabase(
          `wallets?user_id=eq.${encodeURIComponent(deposit.user_id)}` +
          `&select=*&limit=1`
        );

        let wallet = walletRows?.[0];

        if (!wallet) {
          const created = await supabase(
            "wallets",
            {
              method: "POST",
              body: JSON.stringify({
                user_id: deposit.user_id,
                balance: amount,
                updated_at:
                  new Date().toISOString()
              })
            }
          );

          wallet = created?.[0];
        } else {
          const currentBalance =
            Number(wallet.balance || 0);

          const newBalance =
            currentBalance + amount;

          const updated = await supabase(
            `wallets?user_id=eq.${encodeURIComponent(deposit.user_id)}`,
            {
              method: "PATCH",
              body: JSON.stringify({
                balance: newBalance,
                updated_at:
                  new Date().toISOString()
              })
            }
          );

          wallet = updated?.[0] || {
            ...wallet,
            balance: newBalance
          };
        }

        const balanceAfter =
          Number(wallet?.balance || amount);

        await supabase(
          "wallet_transactions",
          {
            method: "POST",
            body: JSON.stringify({
              user_id: deposit.user_id,
              amount,
              balance_after: balanceAfter,
              type: "deposit",
              description:
                "Deposit approved by admin"
            })
          }
        );

        const updatedDeposit =
          await supabase(
            `deposits?id=eq.${encodeURIComponent(depositId)}`,
            {
              method: "PATCH",
              body: JSON.stringify({
                status: "approved",
                approved_by: user.id,
                approved_at:
                  new Date().toISOString(),
                updated_at:
                  new Date().toISOString()
              })
            }
          );

        return json(res, 200, {
          success: true,
          message: "Deposit approved successfully.",
          deposit:
            updatedDeposit?.[0] || null
        });
      }

      /*
        Customer deposit request
      */
      const amount = Number(body.amount);

      if (!Number.isFinite(amount) || amount <= 0) {
        return json(res, 400, {
          success: false,
          error: "Enter a valid deposit amount."
        });
      }

      const created = await supabase(
        "deposits",
        {
          method: "POST",
          body: JSON.stringify({
            user_id: user.id,
            amount,
            payment_method:
              body.payment_method ||
              body.paymentMethod ||
              "OPay",
            payment_reference:
              body.payment_reference ||
              body.paymentReference ||
              null,
            receipt_url:
              body.receipt_url ||
              body.receiptUrl ||
              null,
            customer_note:
              body.customer_note ||
              body.customerNote ||
              null,
            status: "pending"
          })
        }
      );

      return json(res, 201, {
        success: true,
        message:
          "Deposit submitted successfully. It is now pending admin review.",
        deposit: created?.[0] || null
      });
    }

    return json(res, 405, {
      success: false,
      error: "Method not allowed."
    });

  } catch (error) {
    console.error("deposit.js error:", error);

    return json(res, 500, {
      success: false,
      error:
        error.message ||
        "Deposit request failed."
    });
  }
}
