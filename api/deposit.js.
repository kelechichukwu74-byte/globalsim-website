import { authUser, sb } from "./_supabase.js";
function q(v){return encodeURIComponent(String(v??""))}
async function isAdmin(userId){
  const rows=await sb(`profiles?id=eq.${q(userId)}&select=role&limit=1`);
  return rows?.[0]?.role==="admin";
}
export default async function handler(req,res){
  try{
    const user=await authUser(req);
    const admin=await isAdmin(user.id);
    if(req.method==="GET"){
      const rows=admin
        ? await sb("deposits?select=*&order=created_at.desc")
        : await sb(`deposits?user_id=eq.${q(user.id)}&select=*&order=created_at.desc`);
      return res.status(200).json({success:true,deposits:rows});
    }
    if(req.method==="POST"){
      const b=req.body||{};
      if(b.admin){
        if(!admin) return res.status(403).json({success:false,error:"Admin access required."});
        const id=b.depositId, action=b.action;
        if(!id||!["approve","reject"].includes(action)) return res.status(400).json({success:false,error:"Invalid deposit action."});
        const rows=await sb(`deposits?id=eq.${q(id)}&select=*&limit=1`);
        const d=rows?.[0];
        if(!d) return res.status(404).json({success:false,error:"Deposit not found."});
        if(d.status!=="pending") return res.status(400).json({success:false,error:"This deposit has already been processed."});
        if(action==="reject"){
          await sb(`deposits?id=eq.${q(id)}`,{method:"PATCH",body:JSON.stringify({status:"rejected",approved_by:user.id,approved_at:new Date().toISOString(),updated_at:new Date().toISOString()})});
          return res.status(200).json({success:true,message:"Deposit rejected."});
        }
        const amount=Number(d.amount);
        if(!Number.isFinite(amount)||amount<=0) return res.status(400).json({success:false,error:"Invalid deposit amount."});
        const wallets=await sb(`wallets?user_id=eq.${q(d.user_id)}&select=balance&limit=1`);
        if(!wallets?.[0]) return res.status(400).json({success:false,error:"Customer wallet not found."});
        const newBalance=Number(wallets[0].balance||0)+amount;
        await sb(`wallets?user_id=eq.${q(d.user_id)}`,{method:"PATCH",body:JSON.stringify({balance:newBalance,updated_at:new Date().toISOString()})});
        await sb(`deposits?id=eq.${q(id)}`,{method:"PATCH",body:JSON.stringify({status:"approved",approved_by:user.id,approved_at:new Date().toISOString(),updated_at:new Date().toISOString()})});
        try{await sb("wallet_transactions",{method:"POST",body:JSON.stringify({user_id:d.user_id,amount,balance_after:newBalance,type:"deposit",description:`Deposit approved${d.payment_reference?` — ${d.payment_reference}`:""}`})});}catch(e){console.error(e)}
        return res.status(200).json({success:true,message:"Deposit approved.",balance:newBalance});
      }
      const amount=Number(b.amount);
      if(!Number.isFinite(amount)||amount<=0) return res.status(400).json({success:false,error:"Enter a valid deposit amount."});
      const row=await sb("deposits",{method:"POST",body:JSON.stringify({user_id:user.id,amount,status:"pending",customer_note:b.customerNote||null,payment_reference:b.paymentReference||null,receipt_url:b.receiptUrl||null})});
      return res.status(200).json({success:true,deposit:row?.[0]||null});
    }
    return res.status(405).json({success:false,error:"Method not allowed"});
  }catch(e){
    const code=e.message==="Unauthorized."?401:500;
    res.status(code).json({success:false,error:e.message||"Deposit request failed."});
  }
}
