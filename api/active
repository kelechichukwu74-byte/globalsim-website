/* =========================================================
   SMS + AUTO MOVE TO ORDER HISTORY
   ========================================================= */

function checkActiveNumberSMS(item, index) {

  const verificationId =
    item.provider_verification_id ||
    item.providerVerificationId ||
    item.verification_id ||
    item.verificationId ||
    item.provider_order_id ||
    item.providerOrderId ||
    item.verification?.request_id ||
    item.verification?.requestId ||
    item.verification?.id;

  if (!verificationId) {
    console.error(
      "SMS: Provider verification ID is missing.",
      item
    );
    return;
  }

  const smsStatus =
    $(`smsStatus-${index}`);

  const smsContent =
    $(`smsContent-${index}`);

  if (!smsStatus || !smsContent) {
    return;
  }

  let smsReceived = false;
  let historyTimerStarted = false;

  async function checkSMS() {

    if (smsReceived) {
      return;
    }

    try {

      const response =
        await fetch(
          `/api/SMS?id=${encodeURIComponent(
            verificationId
          )}`
        );

      const result =
        await response.json().catch(
          () => ({})
        );

      if (!response.ok) {

        smsStatus.textContent =
          "Waiting for SMS...";

        setTimeout(
          checkSMS,
          5000
        );

        return;
      }

      /*
        SMS.js returns:
        {
          success,
          sms,
          code,
          provider_response
        }
      */

      const provider =
        result?.provider_response ||
        result?.data ||
        result?.verification ||
        {};

      const sms =
        result?.sms ||
        result?.code ||
        provider?.sms ||
        provider?.code ||
        provider?.otp ||
        provider?.verification_code ||
        provider?.verificationCode ||
        null;

      if (sms) {

        smsReceived = true;

        smsStatus.textContent =
          "SMS received";

        smsStatus.classList.add(
          "received"
        );

        smsContent.innerHTML = `
          <div class="sms-received">
            <div class="sms-code">
              ${escapeHtml(
                String(sms)
              )}
            </div>
          </div>
        `;

        /*
          Code has arrived.
          Keep the number visible for
          exactly 1 minute, then remove it
          from Active Number.

          We do NOT cancel it.
          We do NOT refund it.
          The order remains in Supabase
          and therefore remains in
          Order History.
        */

        if (!historyTimerStarted) {

          historyTimerStarted = true;

          setTimeout(
            async () => {

              try {

                /*
                  Refresh active numbers.
                  Because the order remains in
                  the database, loadOrderHistory()
                  will still show it there.
                */

                await loadActiveNumbers();

                if (
                  typeof loadOrderHistory ===
                  "function"
                ) {
                  await loadOrderHistory();
                }

              } catch (error) {

                console.error(
                  "Moving completed number to history error:",
                  error
                );

              }

            },
            60 * 1000
          );
        }

        return;
      }

      smsStatus.textContent =
        "Waiting for SMS...";

      setTimeout(
        checkSMS,
        5000
      );

    } catch (error) {

      console.error(
        "SMS polling error:",
        error
      );

      smsStatus.textContent =
        "Waiting for SMS...";

      setTimeout(
        checkSMS,
        7000
      );
    }
  }

  checkSMS();
}
