const SUPABASE_URL =
  process.env.SUPABASE_URL ||
  "https://rfitbmkizfmwfqqskwhy.supabase.co";

const SUPABASE_PUBLISHABLE_KEY =
  process.env.SUPABASE_PUBLISHABLE_KEY ||
  "sb_publishable_erjKhsDOoyhbjHDExvQ7RQ_gpGcK0C-";

const SUPABASE_SERVICE_ROLE_KEY =
  process.env.SUPABASE_SERVICE_ROLE_KEY;

function quote(value) {
  return encodeURIComponent(String(value ?? ""));
}

function getBearerToken(req) {
  const header =
    req.headers?.authorization ||
    req.headers?.Authorization ||
    "";

  if (!header.startsWith("Bearer ")) {
    return null;
  }

  return header.slice(7).trim();
}

async function getAuthenticatedUser(req) {
  const token = getBearerToken(req);

  if (!token) {
    throw new Error("Unauthorized.");
  }

  const response = await fetch(
    `${SUPABASE_URL}/auth/v1/user`,
    {
      headers: {
        apikey: SUPABASE_PUBLISHABLE_KEY,
        Authorization: `Bearer ${token}`,
        Accept: "application/json"
      }
    }
  );

  if (!response.ok) {
    throw new Error("Unauthorized.");
  }

  const user = await response.json();

  if (!user?.id) {
    throw new Error("Unauthorized.");
  }

  return user;
}

async function supabaseRequest(path, options = {}) {
  if (!SUPABASE_SERVICE_ROLE_KEY) {
    throw new Error(
      "SUPABASE_SERVICE_ROLE_KEY is not configured."
    );
  }

  const response = await fetch(
    `${SUPABASE_URL}/rest/v1/${path}`,
    {
      ...options,
      headers: {
        apikey: SUPABASE_SERVICE_ROLE_KEY,
        Authorization:
          `Bearer ${SUPABASE_SERVICE_ROLE_KEY}`,
        "Content-Type": "application/json",
        Accept: "application/json",
        Prefer: "return=representation",
        ...(options.headers || {})
      }
    }
  );

  const text = await response.text();

  let data = {};

  try {
    data = text ? JSON.parse(text) : {};
  } catch {
    throw new Error(
      `Supabase returned invalid JSON (HTTP ${response.status}).`
    );
  }

  if (!response.ok) {
    throw new Error(
      data?.message ||
      data?.hint ||
      data?.details ||
      `Supabase request failed (HTTP ${response.status}).`
    );
  }

  return data;
}

async function hasRefund(orderId) {
  const rows = await supabaseRequest(
    `wallet_transactions` +
    `?type=eq.refund` +
    `&reference_id=eq.${quote(orderId)}` +
    `&select=id,amount,created_at` +
    `&limit=1`
  );

  return Boolean(rows?.length);
}

async function refundExpiredOrder(order) {
  if (!order?.id || !order?.user_id) {
    return {
      refunded: false,
      alreadyRefunded: false,
      amount: 0
    };
  }

  if (await hasRefund(order.id)) {
    return {
      refunded: true,
      alreadyRefunded: true,
      amount: Number(order.customer_price || 0)
    };
  }

  const amount =
    Number(order.customer_price || 0);

  if (!Number.isFinite(amount) || amount <= 0) {
    return {
      refunded: false,
      alreadyRefunded: false,
      amount: 0
    };
  }

  const walletRows =
    await supabaseRequest(
      `wallets?user_id=eq.${quote(order.user_id)}` +
      `&select=user_id,balance&limit=1`
    );

  const wallet = walletRows?.[0];

  if (!wallet) {
    await supabaseRequest(
      "wallets",
      {
        method: "POST",
        body: JSON.stringify({
          user_id: order.user_id,
          balance: amount
        })
      }
    );

    await supabaseRequest(
      "wallet_transactions",
      {
        method: "POST",
        body: JSON.stringify({
          user_id: order.user_id,
          type: "refund",
          amount,
          balance_before: 0,
          balance_after: amount,
          reference_id: order.id,
          description:
            "Refund for expired virtual number order"
        })
      }
    );

    return {
      refunded: true,
      alreadyRefunded: false,
      amount
    };
  }

  const before =
    Number(wallet.balance || 0);

  const after =
    before + amount;

  await supabaseRequest(
    `wallets?user_id=eq.${quote(order.user_id)}`,
    {
      method: "PATCH",
      body: JSON.stringify({
        balance: after,
        updated_at:
          new Date().toISOString()
      })
    }
  );

  await supabaseRequest(
    "wallet_transactions",
    {
      method: "POST",
      body: JSON.stringify({
        user_id: order.user_id,
        type: "refund",
        amount,
        balance_before: before,
        balance_after: after,
        reference_id: order.id,
        description:
          "Refund for expired virtual number order"
      })
    }
  );

  return {
    refunded: true,
    alreadyRefunded: false,
    amount
  };
}

async function markExpired(order) {
  const refund =
    await refundExpiredOrder(order);

  await supabaseRequest(
    `orders?id=eq.${quote(order.id)}` +
    `&user_id=eq.${quote(order.user_id)}`,
    {
      method: "PATCH",
      body: JSON.stringify({
        status: "expired",
        updated_at:
          new Date().toISOString()
      })
    }
  );

  return {
    ...order,
    status: "expired",
    refund
  };
}

async function completeOrder(order, userId) {
  if (!order?.id) {
    throw new Error("Order ID is required.");
  }

  if (order.user_id !== userId) {
    throw new Error("Unauthorized.");
  }

  const status =
    String(order.status || "").toLowerCase();

  if (
    !["active", "pending"].includes(status)
  ) {
    return order;
  }

  const rows = await supabaseRequest(
    `orders?id=eq.${quote(order.id)}` +
    `&user_id=eq.${quote(userId)}` +
    `&select=*`,
    {
      method: "PATCH",
      body: JSON.stringify({
        status: "completed",
        updated_at:
          new Date().toISOString()
      })
    }
  );

  return rows?.[0] || {
    ...order,
    status: "completed"
  };
}

export default async function handler(req, res) {

  /*
   * GET
   * Loads the user's active numbers.
   */

  if (req.method === "GET") {

    try {

      const user =
        await getAuthenticatedUser(req);

      const orders =
        await supabaseRequest(
          `orders?user_id=eq.${quote(user.id)}` +
          `&select=*` +
          `&order=created_at.desc`
        );

      const activeNumbers = [];
      const expiredNumbers = [];

      for (const order of orders || []) {

        const status =
          String(
            order.status || ""
          ).toLowerCase();

        if (
          !["active", "pending"].includes(status)
        ) {
          continue;
        }

        let expired = false;

        const expiresAt =
          order.provider_expired_at
            ? new Date(
                order.provider_expired_at
              )
            : null;

        if (
          expiresAt &&
          !Number.isNaN(
            expiresAt.getTime()
          )
        ) {
          expired =
            expiresAt.getTime() <= Date.now();
        }

        if (expired) {

          const expiredOrder =
            await markExpired(order);

          expiredNumbers.push({
            ...expiredOrder,
            order_id: order.id,
            phone_number:
              order.phone_number,
            service_name:
              order.service_name,
            country_name:
              order.country_name,
            provider_verification_id:
              order.provider_verification_id,
            provider_order_id:
              order.provider_order_id,
            expired_at:
              order.provider_expired_at,
            status: "expired",
            refunded:
              expiredOrder.refund?.refunded ||
              false,
            refund_amount:
              expiredOrder.refund?.amount ||
              0
          });

          continue;
        }

        activeNumbers.push({
          id: order.id,

          order_id: order.id,

          provider_order_id:
            order.provider_order_id,

          provider_verification_id:
            order.provider_verification_id,

          verification_id:
            order.provider_verification_id,

          phone_number:
            order.phone_number,

          number:
            order.phone_number,

          service_name:
            order.service_name,

          service:
            order.service_name,

          country_name:
            order.country_name,

          status:
            order.status,

          customer_price:
            Number(
              order.customer_price || 0
            ),

          selling_price:
            Number(
              order.customer_price || 0
            ),

          provider_cost:
            Number(
              order.provider_cost || 0
            ),

          created_at:
            order.created_at,

          updated_at:
            order.updated_at,

          provider_expired_at:
            order.provider_expired_at,

          expired_at:
            order.provider_expired_at
        });
      }

      return res.status(200).json({
        success: true,

        numbers:
          activeNumbers,

        activations:
          activeNumbers,

        data:
          activeNumbers,

        expired:
          expiredNumbers,

        count:
          activeNumbers.length,

        expired_count:
          expiredNumbers.length
      });

    } catch (error) {

      console.error(
        "Active numbers API error:",
        error
      );

      return res.status(500).json({
        success: false,
        error:
          error?.message ||
          "Unable to load active numbers."
      });
    }
  }


  /*
   * POST
   * Moves a number from Active Numbers
   * to Order History after SMS is received.
   *
   * NO REFUND.
   */

  if (req.method === "POST") {

    try {

      const user =
        await getAuthenticatedUser(req);

      const body =
        typeof req.body === "string"
          ? JSON.parse(req.body || "{}")
          : (req.body || {});

      const orderId =
        String(
          body.orderId ||
          body.id ||
          ""
        ).trim();

      if (!orderId) {
        return res.status(400).json({
          success: false,
          error: "Order ID is required."
        });
      }

      const rows =
        await supabaseRequest(
          `orders?id=eq.${quote(orderId)}` +
          `&user_id=eq.${quote(user.id)}` +
          `&select=*` +
          `&limit=1`
        );

      const order = rows?.[0];

      if (!order) {
        return res.status(404).json({
          success: false,
          error: "Order not found."
        });
      }

      const completed =
        await completeOrder(
          order,
          user.id
        );

      return res.status(200).json({
        success: true,
        message:
          "Number moved to order history.",
        order: completed
      });

    } catch (error) {

      console.error(
        "Complete active number error:",
        error
      );

      return res.status(500).json({
        success: false,
        error:
          error?.message ||
          "Unable to complete number."
      });
    }
  }


  return res.status(405).json({
    success: false,
    error: "Method not allowed."
  });
}
