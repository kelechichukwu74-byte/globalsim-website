<section id="activeNumbersSection">
  <h2>Active Numbers</h2>
  <p>Your currently active number activations.</p>

  <button type="button" onclick="loadActiveNumbers()">
    Refresh
  </button>

  <div id="activeNumbersList" style="margin-top:20px;"></div>
</section>

<script>
async function loadActiveNumbers() {
  const list = document.getElementById("activeNumbersList");

  list.innerHTML = "<p>Loading active numbers...</p>";

  try {
    const { data, error } = await supabaseClient.auth.getSession();

    if (error || !data.session) {
      throw new Error("Please log in again.");
    }

    const response = await fetch("/api/sms/active", {
      headers: {
        Authorization: "Bearer " + data.session.access_token
      }
    });

    const result = await response.json();

    if (!response.ok || !result.success) {
      throw new Error(
        result.error || "Unable to load active numbers."
      );
    }

    const numbers =
      result.numbers ||
      result.activations ||
      result.data ||
      [];

    if (!numbers.length) {
      list.innerHTML = "<p>No active numbers.</p>";
      return;
    }

    list.innerHTML = numbers.map(order => {

      const verificationId =
        order.verification_id ||
        order.provider_order_id;

      const number =
        order.number ||
        order.phone_number ||
        "Unknown";

      const service =
        order.service ||
        order.service_name ||
        "Unknown";

      const status =
        order.status ||
        "active";

      const created =
        order.created_at
          ? new Date(order.created_at).toLocaleString()
          : "—";

      return `
        <div
          class="active-number"
          data-id="${escapeHtml(verificationId)}"
          style="
            border:1px solid #ddd;
            border-radius:12px;
            padding:16px;
            margin:15px 0;
          "
        >

          <div>
            <strong>Number</strong>
            <div>${escapeHtml(number)}</div>
          </div>

          <div style="margin-top:8px;">
            <strong>Service</strong>
            <div>${escapeHtml(service)}</div>
          </div>

          <div style="margin-top:8px;">
            <strong>Status</strong>
            <div>${escapeHtml(status)}</div>
          </div>

          <div style="margin-top:8px;">
            <strong>Created</strong>
            <div>${escapeHtml(created)}</div>
          </div>

          <div
            class="sms-box"
            style="
              display:none;
              margin-top:12px;
              padding:10px;
              border-radius:8px;
              background:#f3f3f3;
            "
          ></div>

          <div
            style="
              display:flex;
              gap:10px;
              margin-top:15px;
              flex-wrap:wrap;
            "
          >

            <button
              type="button"
              onclick="checkSMS(this)"
            >
              📩 Check SMS
            </button>

            <button
              type="button"
              onclick="cancelNumber(this)"
            >
              ❌ Cancel Number
            </button>

          </div>

        </div>
      `;
    }).join("");

  } catch (error) {
    console.error(error);

    list.innerHTML = `
      <p>${escapeHtml(
        error.message || "Unable to load active numbers."
      )}</p>
    `;
  }
}


async function checkSMS(button) {

  const card = button.closest(".active-number");

  const id = card.dataset.id;

  const box = card.querySelector(".sms-box");

  button.disabled = true;
  button.textContent = "Checking...";

  try {

    const response = await fetch(
      "/api/sms/sms?id=" +
      encodeURIComponent(id)
    );

    const result = await response.json();

    box.style.display = "block";

    if (!response.ok || !result.success) {
      box.textContent =
        result.error || "Unable to load SMS.";
      return;
    }

    const sms =
      result.sms ||
      result.message ||
      result.code ||
      result.data?.sms ||
      result.data?.message ||
      result.data?.code;

    if (sms) {
      box.innerHTML =
        "<strong>📩 SMS Received</strong><br>" +
        escapeHtml(
          typeof sms === "string"
            ? sms
            : JSON.stringify(sms)
        );
    } else {
      box.textContent =
        "No SMS received yet. Tap Check SMS again.";
    }

  } catch (error) {

    box.style.display = "block";
    box.textContent =
      error.message || "Unable to load SMS.";

  } finally {

    button.disabled = false;
    button.textContent = "📩 Check SMS";
  }
}


async function cancelNumber(button) {

  const card = button.closest(".active-number");

  const id = card.dataset.id;

  if (!confirm(
    "Are you sure you want to cancel this number?"
  )) {
    return;
  }

  button.disabled = true;
  button.textContent = "Cancelling...";

  try {

    const { data, error } =
      await supabaseClient.auth.getSession();

    if (error || !data.session) {
      throw new Error("Please log in again.");
    }

    const response = await fetch(
      "/api/sms/cancel",
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization:
            "Bearer " + data.session.access_token
        },
        body: JSON.stringify({
          verificationId: id
        })
      }
    );

    const result = await response.json();

    if (!response.ok || !result.success) {
      throw new Error(
        result.error ||
        "Unable to cancel number."
      );
    }

    alert(
      result.message ||
      "Number cancelled and wallet refunded."
    );

    loadActiveNumbers();

  } catch (error) {

    alert(
      error.message ||
      "Unable to cancel number."
    );

    button.disabled = false;
    button.textContent = "❌ Cancel Number";
  }
}


function escapeHtml(value) {
  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}


document.addEventListener(
  "DOMContentLoaded",
  loadActiveNumbers
);
</script>
