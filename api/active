import { sureVerificationRequest } from "./_lib.js";

const SUPABASE_URL =
  process.env.SUPABASE_URL ||
  "https://rfitbmkizfmwfqqskwhy.supabase.co";

const SUPABASE_PUBLISHABLE_KEY =
  process.env.SUPABASE_PUBLISHABLE_KEY ||
  "sb_publishable_erjKhsDOoyhbjHDExvQ7RQ_gpGcK0C-";

const SUPABASE_SERVICE_ROLE_KEY =
  process.env.SUPABASE_SERVICE_ROLE_KEY;

const SMS_HOLD_MS = 60 * 1000;

function quote(value) {
  return encodeURIComponent(String(value ?? ""));
}

function getBearerToken(req) {
  const header =
    req.headers?.authorization ||
    req.headers?.Authorization ||
    "";

  return header.startsWith("Bearer ")
    ? header.slice(7).trim()
    : null;
}

async function getAuthenticatedUser(req) {
  const token = getBearerToken(req);

  if (!token) {
    throw new Error("Unauthorized.");
  }

  const response = await fetch(
    `${SUPABASE_URL}/auth/v1/user`,
    {
      headers: {
        apikey: SUPABASE_PUBLISHABLE_KEY,
        Authorization: `Bearer ${token}`,
        Accept: "application/json"
      }
    }
  );

  if (!response.ok) {
    throw new Error("Unauthorized.");
  }

  const user = await response.json();

  if (!user?.id) {
    throw new Error("Unauthorized.");
  }

  return user;
}

async function supabaseRequest(path, options = {}) {
  if (!SUPABASE_SERVICE_ROLE_KEY) {
    throw new Error(
      "SUPABASE_SERVICE_ROLE_KEY is not configured."
    );
  }

  const response = await fetch(
    `${SUPABASE_URL}/rest/v1/${path}`,
    {
      ...options,
      headers: {
        apikey: SUPABASE_SERVICE_ROLE_KEY,
        Authorization:
          `Bearer ${SUPABASE_SERVICE_ROLE_KEY}`,
        "Content-Type": "application/json",
        Accept: "application/json",
        Prefer: "return=representation",
        ...(options.headers || {})
      }
    }
  );

  const text = await response.text();

  let data = {};

  try {
    data = text ? JSON.parse(text) : {};
  } catch {
    throw new Error(
      `Supabase returned invalid JSON (HTTP ${response.status}).`
    );
  }

  if (!response.ok) {
    throw new Error(
      data?.message ||
      data?.hint ||
      data?.details ||
      `Supabase request failed (HTTP ${response.status}).`
    );
  }

  return data;
}

async function hasRefund(orderId) {
  const rows = await supabaseRequest(
    `wallet_transactions` +
    `?type=eq.refund` +
    `&reference_id=eq.${quote(orderId)}` +
    `&select=id&limit=1`
  );

  return Boolean(rows?.length);
}

async function refundExpiredOrder(order) {
  if (!order?.id || !order?.user_id) {
    return {
      refunded: false,
      amount: 0
    };
  }

  if (await hasRefund(order.id)) {
    return {
      refunded: true,
      amount: Number(order.customer_price || 0)
    };
  }

  const amount =
    Number(order.customer_price || 0);

  if (!Number.isFinite(amount) || amount <= 0) {
    return {
      refunded: false,
      amount: 0
    };
  }

  const walletRows =
    await supabaseRequest(
      `wallets?user_id=eq.${quote(order.user_id)}` +
      `&select=user_id,balance&limit=1`
    );

  const wallet = walletRows?.[0];

  if (!wallet) {
    await supabaseRequest("wallets", {
      method: "POST",
      body: JSON.stringify({
        user_id: order.user_id,
        balance: amount
      })
    });

    await supabaseRequest(
      "wallet_transactions",
      {
        method: "POST",
        body: JSON.stringify({
          user_id: order.user_id,
          type: "refund",
          amount,
          balance_before: 0,
          balance_after: amount,
          reference_id: order.id,
          description:
            "Refund for expired virtual number order"
        })
      }
    );

    return {
      refunded: true,
      amount
    };
  }

  const before =
    Number(wallet.balance || 0);

  const after = before + amount;

  await supabaseRequest(
    `wallets?user_id=eq.${quote(order.user_id)}`,
    {
      method: "PATCH",
      body: JSON.stringify({
        balance: after,
        updated_at:
          new Date().toISOString()
      })
    }
  );

  await supabaseRequest(
    "wallet_transactions",
    {
      method: "POST",
      body: JSON.stringify({
        user_id: order.user_id,
        type: "refund",
        amount,
        balance_before: before,
        balance_after: after,
        reference_id: order.id,
        description:
          "Refund for expired virtual number order"
      })
    }
  );

  return {
    refunded: true,
    amount
  };
}

async function markExpired(order) {
  const refund =
    await refundExpiredOrder(order);

  const rows =
    await supabaseRequest(
      `orders?id=eq.${quote(order.id)}` +
      `&user_id=eq.${quote(order.user_id)}`,
      {
        method: "PATCH",
        body: JSON.stringify({
          status: "expired",
          updated_at:
            new Date().toISOString()
        })
      }
    );

  return {
    ...(rows?.[0] || order),
    status: "expired",
    refund
  };
}

/*
 * Provider verification ID.
 *
 * The SureVerification SMS endpoint requires:
 *
 * /verifications/sms/:verificationId
 *
 * Prefer provider_verification_id.
 * Fall back to provider_order_id for existing orders.
 */
function getVerificationId(order) {
  return String(
    order?.provider_verification_id ||
    order?.provider_order_id ||
    ""
  ).trim();
}

async function getProviderSms(order) {
  const verificationId =
    getVerificationId(order);

  if (!verificationId) {
    return {
      code: null,
      sms: null,
      received: false,
      error: "Verification ID is missing."
    };
  }

  try {
    const data =
      await sureVerificationRequest(
        `/verifications/sms/${encodeURIComponent(
          verificationId
        )}`
      );

    const list =
      Array.isArray(data?.sms)
        ? data.sms
        : [];

    const latest =
      list.length
        ? list[list.length - 1]
        : null;

    const code =
      latest?.formatted ||
      latest?.raw ||
      null;

    return {
      code,
      sms: code,
      received: Boolean(code),
      error: null
    };

  } catch (error) {
    console.error(
      "SureVerification SMS error:",
      error
    );

    return {
      code: null,
      sms: null,
      received: false,
      error:
        error?.message ||
        "Unable to retrieve SMS."
    };
  }
}

async function markSmsReceived(order) {
  const now =
    new Date().toISOString();

  const rows =
    await supabaseRequest(
      `orders?id=eq.${quote(order.id)}` +
      `&user_id=eq.${quote(order.user_id)}`,
      {
        method: "PATCH",
        body: JSON.stringify({
          status: "sms_received",
          updated_at: now
        })
      }
    );

  return rows?.[0] || {
    ...order,
    status: "sms_received",
    updated_at: now
  };
}

async function completeOrder(order) {
  const rows =
    await supabaseRequest(
      `orders?id=eq.${quote(order.id)}` +
      `&user_id=eq.${quote(order.user_id)}`,
      {
        method: "PATCH",
        body: JSON.stringify({
          status: "completed",
          updated_at:
            new Date().toISOString()
        })
      }
    );

  return rows?.[0] || {
    ...order,
    status: "completed"
  };
}

function formatNumber(order, sms = {}) {
  return {
    id: order.id,

    order_id:
      order.id,

    provider_order_id:
      order.provider_order_id,

    provider_verification_id:
      order.provider_verification_id,

    verification_id:
      getVerificationId(order),

    phone_number:
      order.phone_number,

    number:
      order.phone_number,

    service_name:
      order.service_name,

    service:
      order.service_name,

    country_name:
      order.country_name,

    status:
      order.status,

    customer_price:
      Number(order.customer_price || 0),

    selling_price:
      Number(order.customer_price || 0),

    provider_cost:
      Number(order.provider_cost || 0),

    created_at:
      order.created_at,

    updated_at:
      order.updated_at,

    provider_expired_at:
      order.provider_expired_at,

    expired_at:
      order.provider_expired_at,

    sms:
      sms.sms || null,

    code:
      sms.code || null,

    sms_received:
      Boolean(sms.received),

    sms_error:
      sms.error || null
  };
}

export default async function handler(req, res) {

  if (req.method === "GET") {

    try {

      const user =
        await getAuthenticatedUser(req);

      const orders =
        await supabaseRequest(
          `orders?user_id=eq.${quote(user.id)}` +
          `&select=*` +
          `&order=created_at.desc`
        );

      const activeNumbers = [];
      const expiredNumbers = [];

      for (const originalOrder of orders || []) {

        let order = originalOrder;

        const status =
          String(order.status || "")
            .toLowerCase();

        /*
         * Already received SMS.
         *
         * Keep it visible for exactly 1 minute,
         * then move it to Order History.
         */
        if (status === "sms_received") {

          const receivedAt =
            new Date(order.updated_at);

          const elapsed =
            Date.now() -
            receivedAt.getTime();

          if (
            !Number.isNaN(
              receivedAt.getTime()
            ) &&
            elapsed >= SMS_HOLD_MS
          ) {

            await completeOrder(order);

            continue;
          }

          const sms =
            await getProviderSms(order);

          activeNumbers.push(
            formatNumber(order, sms)
          );

          continue;
        }

        if (
          !["active", "pending"]
            .includes(status)
        ) {
          continue;
        }

        /*
         * Exact provider expiry time.
         */
        const expiresAt =
          order.provider_expired_at
            ? new Date(
                order.provider_expired_at
              )
            : null;

        if (
          expiresAt &&
          !Number.isNaN(
            expiresAt.getTime()
          ) &&
          expiresAt.getTime() <= Date.now()
        ) {

          const expired =
            await markExpired(order);

          expiredNumbers.push({
            ...expired,

            order_id:
              order.id,

            phone_number:
              order.phone_number,

            service_name:
              order.service_name,

            country_name:
              order.country_name,

            provider_verification_id:
              order.provider_verification_id,

            provider_order_id:
              order.provider_order_id,

            expired_at:
              order.provider_expired_at,

            status: "expired",

            refunded:
              expired.refund?.refunded ||
              false,

            refund_amount:
              expired.refund?.amount ||
              0
          });

          continue;
        }

        /*
         * Poll SureVerification for SMS.
         */
        const sms =
          await getProviderSms(order);

        /*
         * SMS arrived.
         *
         * Change status to sms_received.
         * updated_at becomes the exact beginning
         * of the one-minute Active timer.
         */
        if (sms.received) {

          order =
            await markSmsReceived(order);

          activeNumbers.push(
            formatNumber(order, sms)
          );

          continue;
        }

        activeNumbers.push(
          formatNumber(order, sms)
        );
      }

      return res.status(200).json({
        success: true,

        numbers:
          activeNumbers,

        activations:
          activeNumbers,

        data:
          activeNumbers,

        expired:
          expiredNumbers,

        count:
          activeNumbers.length,

        expired_count:
          expiredNumbers.length
      });

    } catch (error) {

      console.error(
        "Active numbers API error:",
        error
      );

      return res.status(500).json({
        success: false,
        error:
          error?.message ||
          "Unable to load active numbers."
      });
    }
  }

  /*
   * POST
   * Manual move to Order History.
   * No refund.
   */

  if (req.method === "POST") {

    try {

      const user =
        await getAuthenticatedUser(req);

      const body =
        typeof req.body === "string"
          ? JSON.parse(req.body || "{}")
          : (req.body || {});

      const orderId =
        String(
          body.orderId ||
          body.id ||
          ""
        ).trim();

      if (!orderId) {
        return res.status(400).json({
          success: false,
          error:
            "Order ID is required."
        });
      }

      const rows =
        await supabaseRequest(
          `orders?id=eq.${quote(orderId)}` +
          `&user_id=eq.${quote(user.id)}` +
          `&select=*` +
          `&limit=1`
        );

      const order = rows?.[0];

      if (!order) {
        return res.status(404).json({
          success: false,
          error: "Order not found."
        });
      }

      const completed =
        await completeOrder(order);

      return res.status(200).json({
        success: true,
        message:
          "Number moved to order history.",
        order: completed
      });

    } catch (error) {

      console.error(
        "Complete active number error:",
        error
      );

      return res.status(500).json({
        success: false,
        error:
          error?.message ||
          "Unable to complete number."
      });
    }
  }

  return res.status(405).json({
    success: false,
    error: "Method not allowed."
  });
}
