import {
  sureVerificationRequest
} from "./_lib.js";

const SUPABASE_URL =
  process.env.SUPABASE_URL ||
  "https://rfitbmkizfmwfqqskwhy.supabase.co";

const SUPABASE_PUBLISHABLE_KEY =
  process.env.SUPABASE_PUBLISHABLE_KEY ||
  "sb_publishable_erjKhsDOoyhbHDExvQ7RQ_gpGcK0C-";

const SUPABASE_SERVICE_ROLE_KEY =
  process.env.SUPABASE_SERVICE_ROLE_KEY;


function quote(value) {
  return encodeURIComponent(
    String(value ?? "")
  );
}


function getBearerToken(req) {
  const header =
    req.headers?.authorization ||
    req.headers?.Authorization ||
    "";

  if (!header.startsWith("Bearer ")) {
    return null;
  }

  return header.slice(7).trim();
}


async function getAuthenticatedUser(req) {
  const token =
    getBearerToken(req);

  if (!token) {
    throw new Error("Unauthorized.");
  }

  const response =
    await fetch(
      `${SUPABASE_URL}/auth/v1/user`,
      {
        headers: {
          apikey:
            SUPABASE_PUBLISHABLE_KEY,
          Authorization:
            `Bearer ${token}`,
          Accept:
            "application/json"
        }
      }
    );

  if (!response.ok) {
    throw new Error("Unauthorized.");
  }

  const user =
    await response.json();

  if (!user?.id) {
    throw new Error("Unauthorized.");
  }

  return user;
}


async function supabaseRequest(
  path,
  options = {}
) {
  if (!SUPABASE_SERVICE_ROLE_KEY) {
    throw new Error(
      "SUPABASE_SERVICE_ROLE_KEY is not configured."
    );
  }

  const response =
    await fetch(
      `${SUPABASE_URL}/rest/v1/${path}`,
      {
        ...options,
        headers: {
          apikey:
            SUPABASE_SERVICE_ROLE_KEY,
          Authorization:
            `Bearer ${SUPABASE_SERVICE_ROLE_KEY}`,
          "Content-Type":
            "application/json",
          Accept:
            "application/json",
          Prefer:
            "return=representation",
          ...(options.headers || {})
        }
      }
    );

  const text =
    await response.text();

  let data = {};

  try {
    data =
      text
        ? JSON.parse(text)
        : {};
  } catch {
    throw new Error(
      `Supabase returned invalid JSON (HTTP ${response.status}).`
    );
  }

  if (!response.ok) {
    throw new Error(
      data?.message ||
      data?.error ||
      data?.hint ||
      data?.details ||
      `Supabase request failed (HTTP ${response.status}).`
    );
  }

  return data;
}


/*
 * Provider timestamps returned by
 * SureVerification have this format:
 *
 * YYYY-MM-DD HH:mm:ss
 *
 * Treat the provider timestamp as UTC
 * when no timezone is supplied.
 */

function parseProviderExpiry(value) {
  if (!value) {
    return null;
  }

  const raw =
    String(value).trim();

  if (!raw) {
    return null;
  }

  if (
    /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/
      .test(raw)
  ) {
    const iso =
      raw.replace(
        " ",
        "T"
      ) + "Z";

    const date =
      new Date(iso);

    if (
      !Number.isNaN(
        date.getTime()
      )
    ) {
      return date;
    }
  }

  const date =
    new Date(raw);

  if (
    Number.isNaN(
      date.getTime()
    )
  ) {
    return null;
  }

  return date;
}


async function getSmsForVerification(
  verificationId
) {
  if (
    verificationId === null ||
    verificationId === undefined ||
    String(verificationId).trim() === ""
  ) {
    return {
      sms: null,
      smsList: [],
      received: false
    };
  }

  try {
    const data =
      await sureVerificationRequest(
        `/verifications/sms/${encodeURIComponent(
          String(verificationId)
        )}`
      );

    const smsList =
      Array.isArray(
        data?.sms
      )
        ? data.sms
        : [];

    const latest =
      smsList.length
        ? smsList[
            smsList.length - 1
          ]
        : null;

    const code =
      latest?.formatted ||
      latest?.raw ||
      null;

    return {
      sms:
        code
          ? String(code)
          : null,

      smsList,

      received:
        Boolean(code)
    };

  } catch (error) {
    return {
      sms: null,
      smsList: [],
      received: false,
      error:
        error?.message ||
        "Unable to retrieve SMS."
    };
  }
}


/*
 * Try the correct numeric verification ID first.
 *
 * For old orders that were created before this fix,
 * provider_verification_id may be missing.
 *
 * We then try provider_order_id as a compatibility
 * fallback.
 */

async function findSms(order) {
  const identifiers = [];

  if (
    order?.provider_verification_id !==
      null &&
    order?.provider_verification_id !==
      undefined &&
    String(
      order.provider_verification_id
    ).trim()
  ) {
    identifiers.push(
      String(
        order.provider_verification_id
      ).trim()
    );
  }

  if (
    order?.provider_order_id !==
      null &&
    order?.provider_order_id !==
      undefined &&
    String(
      order.provider_order_id
    ).trim()
  ) {
    const requestId =
      String(
        order.provider_order_id
      ).trim();

    if (
      !identifiers.includes(
        requestId
      )
    ) {
      identifiers.push(
        requestId
      );
    }
  }

  for (
    const identifier of identifiers
  ) {
    const result =
      await getSmsForVerification(
        identifier
      );

    if (
      result.received
    ) {
      return {
        ...result,
        verificationId:
          identifier
      };
    }
  }

  return {
    sms: null,
    smsList: [],
    received: false,
    verificationId:
      identifiers[0] ||
      null
  };
}


async function markOrder(
  orderId,
  patch
) {
  return await supabaseRequest(
    `orders?id=eq.${quote(
      orderId
    )}`,
    {
      method: "PATCH",
      body:
        JSON.stringify(
          patch
        )
    }
  );
}


/*
 * ---------------------------------------------------------
 * GET ACTIVE NUMBERS
 * ---------------------------------------------------------
 */

async function getActiveOrders(
  userId
) {
  return await supabaseRequest(
    `orders?user_id=eq.${quote(
      userId
    )}&select=*&order=created_at.desc&limit=100`
  );
}


export default async function handler(
  req,
  res
) {
  if (
    req.method !== "GET" &&
    req.method !== "POST"
  ) {
    return res.status(405).json({
      success: false,
      error:
        "Method not allowed."
    });
  }

  try {
    const user =
      await getAuthenticatedUser(
        req
      );

    /*
     * POST:
     *
     * Keep compatibility with the existing
     * Active endpoint.
     *
     * This does NOT refund the user.
     */
    if (
      req.method === "POST"
    ) {
      const body =
        typeof req.body === "string"
          ? JSON.parse(
              req.body
            )
          : (
              req.body || {}
            );

      const orderId =
        body.orderId ||
        body.order_id ||
        body.id;

      if (!orderId) {
        return res.status(400).json({
          success: false,
          error:
            "Order ID is required."
        });
      }

      const rows =
        await supabaseRequest(
          `orders?id=eq.${quote(
            orderId
          )}&user_id=eq.${quote(
            user.id
          )}&select=*&limit=1`
        );

      if (!rows?.length) {
        return res.status(404).json({
          success: false,
          error:
            "Order not found."
        });
      }

      const order =
        rows[0];

      /*
       * POST is only used to mark the
       * order completed manually.
       *
       * No refund.
       */
      const updated =
        await markOrder(
          order.id,
          {
            status:
              "completed",
            updated_at:
              new Date().toISOString()
          }
        );

      return res.status(200).json({
        success: true,
        order:
          updated?.[0] ||
          null
      });
    }


    /*
     * -----------------------------------------------------
     * GET
     * -----------------------------------------------------
     */

    const orders =
      await getActiveOrders(
        user.id
      );

    const now =
      Date.now();

    const active =
      [];

    for (
      const order of orders
    ) {
      const status =
        String(
          order?.status ||
          ""
        )
          .trim()
          .toLowerCase();


      /*
       * Completed/expired orders
       * belong to Order History.
       */
      if (
        status ===
          "completed" ||
        status ===
          "expired" ||
        status ===
          "cancelled" ||
        status ===
          "canceled"
      ) {
        continue;
      }


      /*
       * ---------------------------------------------------
       * EXACT PROVIDER EXPIRY
       * ---------------------------------------------------
       */

      const expiryDate =
        parseProviderExpiry(
          order?.provider_expired_at
        );

      if (
        expiryDate &&
        expiryDate.getTime() <=
          now
      ) {
        try {
          await markOrder(
            order.id,
            {
              status:
                "expired",
              updated_at:
                new Date().toISOString()
            }
          );
        } catch (
          updateError
        ) {
          console.error(
            "Failed to mark expired order:",
            updateError
          );
        }

        continue;
      }


      /*
       * ---------------------------------------------------
       * GET SMS
       * ---------------------------------------------------
       */

      const smsResult =
        await findSms(
          order
        );


      /*
       * ---------------------------------------------------
       * SMS RECEIVED
       * ---------------------------------------------------
       *
       * When the first SMS arrives:
       *
       * status = sms_received
       * updated_at = time SMS was first seen
       *
       * The number remains visible for
       * one minute.
       */

      if (
        smsResult.received
      ) {
        let smsReceivedAt =
          null;

        if (
          status ===
          "sms_received"
        ) {
          const previous =
            new Date(
              order.updated_at
            );

          if (
            !Number.isNaN(
              previous.getTime()
            )
          ) {
            smsReceivedAt =
              previous;
          }
        }

        /*
         * First time code is detected.
         */
        if (
          !smsReceivedAt
        ) {
          smsReceivedAt =
            new Date();

          try {
            const updated =
              await markOrder(
                order.id,
                {
                  status:
                    "sms_received",
                  updated_at:
                    smsReceivedAt.toISOString()
                }
              );

            if (
              updated?.[0]
            ) {
              Object.assign(
                order,
                updated[0]
              );
            }
          } catch (
            updateError
          ) {
            console.error(
              "Failed to save SMS received time:",
              updateError
            );
          }
        }


        const receivedTime =
          smsReceivedAt.getTime();

        const elapsed =
          now -
          receivedTime;


        /*
         * After one minute:
         * remove from Active,
         * keep in Order History.
         */
        if (
          elapsed >=
          60 * 1000
        ) {
          try {
            await markOrder(
              order.id,
              {
                status:
                  "completed",
                updated_at:
                  new Date().toISOString()
              }
            );
          } catch (
            updateError
          ) {
            console.error(
              "Failed to complete SMS order:",
              updateError
            );
          }

          continue;
        }


        active.push({
          ...order,

          status:
            "sms_received",

          sms:
            smsResult.sms,

          code:
            smsResult.sms,

          sms_received:
            true,

          sms_list:
            smsResult.smsList,

          provider_verification_id:
            order.provider_verification_id ||
            smsResult.verificationId,

          verification_id:
            order.provider_verification_id ||
            smsResult.verificationId
        });

        continue;
      }


      /*
       * ---------------------------------------------------
       * STILL WAITING FOR SMS
       * ---------------------------------------------------
       */

      active.push({
        ...order,

        sms:
          null,

        code:
          null,

        sms_received:
          false,

        sms_list:
          [],

        provider_verification_id:
          order.provider_verification_id ||
          null,

        verification_id:
          order.provider_verification_id ||
          null
      });
    }


    return res.status(200).json({
      success: true,

      active,

      numbers:
        active,

      count:
        active.length
    });

  } catch (error) {
    console.error(
      "Active API error:",
      error
    );

    const message =
      error?.message ||
      "Unable to load active numbers.";

    if (
      message ===
      "Unauthorized."
    ) {
      return res.status(401).json({
        success: false,
        error:
          message
      });
    }

    return res.status(500).json({
      success: false,
      error:
        message
    });
  }
}
